{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Codex CN Proxy",
  "version": "1.0.0",
  "identifier": "com.codex-cn-proxy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex CN Proxy",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Developer Tool",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "targets": "all",
    "shortDescription": "Codex CN Proxy 本地服务管理工具",
    "longDescription": "将 Codex 的 OpenAI Responses API 转换成国内大模型的 Chat Completions API 的本地代理工具",
    "externalBin": [],
    "resources": ["resources/providers.json", "resources/server.cjs"]
  },
  "plugins": {}
}
