{
  "name": "cc-proxy",
  "version": "1.2.0",
  "description": "cc-proxy - macOS 菜单栏代理管理工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sync-version": "node -e \"const pkg=require('./package.json');const tauri=require('./src-tauri/tauri.conf.json');tauri.version=pkg.version;require('fs').writeFileSync('./src-tauri/tauri.conf.json',JSON.stringify(tauri,null,2)+'\\\\n')\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
